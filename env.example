# Copy this file to .env
# Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
# Use a model available to your account. The documentation originally names Gemini 1.5 Flash Pro;
# the app keeps this configurable because model availability changes over time.
GEMINI_MODEL=gemini-2.5-flash
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///./pocketsmart.db
UPLOAD_DIR=app/static/uploads
MAX_UPLOAD_MB=5
DEMO_MODE=true
